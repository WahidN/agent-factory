{
  "name": "agent-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "hub": "concurrently -n server,web -c blue,green \"pnpm:dev:hub\" \"pnpm:dev:web\"",
    "dev:hub": "tsx watch server/index.ts --hub",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "fake-park": "tsx scripts/fake-park.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip"
  },
  "dependencies": {
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "knip": "^6.35.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
